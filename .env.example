# Copy to .env (git-ignored). No API keys are required to run the demo.

# SEC EDGAR requires a descriptive User-Agent identifying the requester.
# Anonymous or generic agents get throttled or blocked.
# https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT="Your Name your.email@example.com"

# Pinned data vintage. Cached parquet snapshots are keyed by this tag, so the
# demo reproduces offline regardless of "today". Bump it to re-pull EDGAR.
FPA_DATA_VINTAGE=2026-07

# Company under analysis. NFLX has the cleanest single-segment P&L for this demo.
FPA_TICKER=NFLX
FPA_CIK=0001065280

# --- Odoo (only needed for the seeding step; the app reads the extract) -----
ODOO_URL=http://localhost:8069
ODOO_DB=fpa_demo
ODOO_USER=admin
ODOO_PASSWORD=admin

# --- Narrative layer -------------------------------------------------------
# claudecode = headless `claude -p` (no API key, uses your existing auth)
# fixture    = replay recorded output, fully offline
# anthropic  = direct API (requires ANTHROPIC_API_KEY)
FPA_NARRATIVE_PROVIDER=claudecode
# ANTHROPIC_API_KEY=
